PORT=3000
OPENAI_API_KEY=your_api_key
CORS_ORIGIN=http://localhost:4200
# Remove any old server override of OPENAI_MODEL when migrating.
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_TOKENS_JSON=6000
OPENAI_MAX_TOKENS_NARRATIVES=5000
OPENAI_MAX_TOKENS_CLUES=4000
OPENAI_MAX_TOKENS_REVIEW=4000
OPENAI_MAX_TOKENS_NARRATOR=1500
GENERATION_CHARACTER_BATCH_SIZE=4
GENERATION_CHARACTER_CONCURRENCY=2
GENERATION_STEP_TIMEOUT_MS=90000
GENERATION_GLOBAL_TIMEOUT_MS=600000
